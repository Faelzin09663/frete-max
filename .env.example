# Chave do Google AI Studio (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# minimal | low | medium | high. Se ler mal algum print, teste medium.
GEMINI_THINKING_LEVEL=low

# Chave do Google Cloud com "Geocoding API" e "Routes API" ativadas.
# Sem ela o app funciona com distâncias ESTIMADAS (linha reta x 1,35).
GOOGLE_MAPS_API_KEY=

# Sincronização opcional entre aparelhos (Caminhão e Locais). Sem preencher,
# o app funciona 100% local, como no MVP. Para ativar: crie um projeto grátis
# em supabase.com, rode supabase/schema.sql no SQL Editor, e copie as chaves
# em Project Settings > API (a "anon public", nunca a "service_role").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
